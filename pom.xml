<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.justybase</groupId>
  <artifactId>netezza-sql</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>JustyBase NetezzaSQL JDBC Driver</name>
  <description>Pure Java JDBC driver for IBM Netezza Performance Server</description>
  <url>https://github.com/${github.repo}</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Krzysztof Duśko</name>
      <organization>JustyBase</organization>
      <organizationUrl>https://github.com/justybase</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/${github.repo}.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/${github.repo}.git</developerConnection>
    <url>https://github.com/${github.repo}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/${github.repo}/issues</url>
  </issueManagement>
  <ciManagement>
    <system>GitHub Actions</system>
    <url>https://github.com/${github.repo}/actions/workflows/java-matrix.yml</url>
  </ciManagement>
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>JustyBase GitHub Packages</name>
      <url>https://maven.pkg.github.com/${github.repo}</url>
    </repository>
  </distributionManagement>
  <properties>
    <!-- Neutral epoch keeps archives reproducible without embedding a build date. -->
    <project.build.outputTimestamp>1980-01-01T00:00:02Z</project.build.outputTimestamp>
    <!-- Single place to update when the public release repository changes. -->
    <github.repo>justybase/justybase.netezza.java</github.repo>
    <!-- JDBC 4.3 is part of Java 17; one release-17 jar runs on 17, 21 and 25. -->
    <java.baseline>17</java.baseline>
    <maven.compiler.release>${java.baseline}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <test.groups></test.groups>
    <test.excludedGroups>live,parity,performance</test.excludedGroups>
  </properties>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>require-java-baseline</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${java.baseline},)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <groups>${test.groups}</groups>
          <excludedGroups>${test.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.justybase.netezza</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>live</id>
      <properties>
        <test.groups>live</test.groups>
        <test.excludedGroups>parity</test.excludedGroups>
      </properties>
    </profile>
    <profile>
      <id>parity</id>
      <properties>
        <test.groups>parity</test.groups>
        <test.excludedGroups></test.excludedGroups>
      </properties>
    </profile>
    <profile>
      <id>perf</id>
      <properties>
        <test.groups>performance</test.groups>
        <test.excludedGroups></test.excludedGroups>
      </properties>
    </profile>
  </profiles>
</project>
